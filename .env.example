# Garmin Connect Personal API key (Garmin Connect Web > Personal API Key). Leave empty to run on demo data.
GARMIN_API_KEY=
# Password for the dashboard login page.
DASHBOARD_PASSWORD=
# Random string, 16+ characters, used to sign the login cookie. e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Neon Postgres URL for syncing the Home layout between devices. Leave empty to keep it in this browser only.
DATABASE_URL=
